{
  "hooks": {
    "SessionStart":     [{ "hooks": [{ "type": "command", "command": "python3 ~/ClaudeBuddy/hooks/buddy_hook.py", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "python3 ~/ClaudeBuddy/hooks/buddy_hook.py", "timeout": 5 }] }],
    "PermissionRequest":[{ "matcher": "*", "hooks": [{ "type": "command", "command": "python3 ~/ClaudeBuddy/hooks/buddy_hook.py", "timeout": 30 }] }],
    "PostToolUse":      [{ "matcher": "*", "hooks": [{ "type": "command", "command": "python3 ~/ClaudeBuddy/hooks/buddy_hook.py", "timeout": 5 }] }],
    "Notification":     [{ "hooks": [{ "type": "command", "command": "python3 ~/ClaudeBuddy/hooks/buddy_hook.py", "timeout": 5 }] }],
    "Stop":             [{ "hooks": [{ "type": "command", "command": "python3 ~/ClaudeBuddy/hooks/buddy_hook.py", "timeout": 5 }] }],
    "SessionEnd":       [{ "hooks": [{ "type": "command", "command": "python3 ~/ClaudeBuddy/hooks/buddy_hook.py", "timeout": 5 }] }]
  }
}
